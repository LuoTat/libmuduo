module;
#include <sys/epoll.h>

export module Muduo.Core:EPoll;

import std;
import Muduo.Timestamp;
import :Forward;

namespace ltt
{

/*
 * muduo 库中多路事件分发器的IO复用核心模块
 * 简单来说就是把 epoll 的 API 封装了一下
 * 主要用来管理 Channel 类对象
 */
export class EPoll
{
public:
    EPoll(EventLoop* eventloop);
    ~EPoll();

    Timestamp poll(std::chrono::milliseconds ms, std::span<Channel*> ready_channels);
    void      update_channel(Channel* channel);
    void      remove_channel(Channel* channel);
    bool      has_channel(Channel* channel) const;

private:
    void update_epoll(Channel* channel, int flag);

    EventLoop*                        m_eventloop;       // 绑定的事件循环
    int                               m_epoll_fd;        // 绑定的 epoll 文件描述符
    std::unordered_map<int, Channel*> m_channels_map;    // key:sockfd value:Channel*
    std::vector<epoll_event>          m_epoll_events;    // 用于存放 epoll_wait 返回的所有就绪的事件
};

}    // namespace ltt