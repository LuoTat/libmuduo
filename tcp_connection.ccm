module;
#include <boost/core/noncopyable.hpp>

export module Muduo.TCPCore:TcpConnection;

import std;
import Muduo.Core;
import Muduo.Buffer;
import Muduo.Socket;
import Muduo.Timestamp;
import Muduo.SockAddress;
import :Forward;

namespace ltt
{

export class TcpConnection: public std::enable_shared_from_this<TcpConnection>,
                            private boost::noncopyable
{
public:
    TcpConnection(int connfd, TcpServer* tcp_server, SockAddress sock_addr, SockAddress peer_addr, EventLoop* loop, std::string name);

    ~TcpConnection();

    [[nodiscard]]
    EventLoop* get_loop() const;
    [[nodiscard]]
    std::string get_name() const;
    [[nodiscard]]
    SockAddress get_sockaddr() const;
    [[nodiscard]]
    SockAddress get_peeraddr() const;
    [[nodiscard]]
    bool is_connected() const;
    [[nodiscard]]
    bool is_disconnecting() const;

    void set_connection_changed_callback(ConnectionChangedCallback cb);
    void set_revent_callback(REventCallback cb);
    void set_wevent_callback(WEventCallback cb);
    void set_high_water_mark_callback(HighWaterMarkCallback cb, size_t size);

    // 在 m_loop 中完成 TCP 连接的所有初始化工作，
    void start_connect();
    // 连接销毁
    void close();
    // 发送数据
    void send(const std::span<const std::byte>& data);
    // 关闭半连接
    void shutdown();

private:
    enum class State
    {
        Connecting,       // 正在连接
        Connected,        // 已连接
        Disconnecting,    // 正在断开连接
        Disconnected      // 已经断开连接
    };

    /*
     * 这里是 mainloop 还是 subloop 由 TcpServer 中创建的线程数决定
     * 若为多 Reactor 则该 m_loop 指向 subloop
     * 若为单 Reactor 则该 m_loop 指向 mainloop
     */
    EventLoop*         m_loop;
    TcpServer*         m_tcp_server;    // 该连接所属的服务器
    std::string        m_name;
    std::atomic<State> m_state {State::Connecting};
    bool               m_reading {true};    // 连接是否在监听读事件

    std::unique_ptr<Socket>  m_socket;
    std::unique_ptr<Channel> m_channel;

    // 连接的两端地址
    SockAddress m_sock_addr;
    SockAddress m_peer_addr;

    /*
     * 这些回调用户通过写入 TcpServer 注册
     * TcpServer 再将注册的回调传递给 TcpConnection
     * TcpConnection 再将回调注册到 Channel 中
     */
    ConnectionChangedCallback m_connchange_cb;                     // 连接状态变化的回调
    REventCallback            m_readevent_cb;                      // 读事件后的回调
    WEventCallback            m_writeevent_cb;                     // 写事件后的回调

    HighWaterMarkCallback m_high_water_mark_cb;                    // 高水位回调
    size_t                m_high_water_mark {64 * 1024 * 1024};    // 高水位阈值

    // 数据缓冲区
    Buffer m_input_buf;     // 接收数据的缓冲区
    Buffer m_output_buf;    // 发送数据的缓冲区
};

}    // namespace ltt