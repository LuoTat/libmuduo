export module Muduo.TCPCore:TcpServer;

import std;
import Muduo.Core;
import Muduo.SockAddress;
import Muduo.Acceptor;
import Muduo.EventLoopThreadPool;
import :Forward;

namespace ltt
{

export class TcpServer
{
public:
    using ThreadInitCallback = std::function<void(EventLoop*)>;

    TcpServer(EventLoop* loop, SockAddress addr, std::string name);
    ~TcpServer();

    // 设置回调函数
    // 子线程初始化后的回调
    void set_thread_init_callback(ThreadInitCallback cb);
    void set_connection_changed_callback(ConnectionChangedCallback cb);
    void set_revent_callback(REventCallback cb);
    void set_wevent_callback(WEventCallback cb);
    // 设置底层 subloop 的个数
    void set_thread_num(int num);

    // 开启服务器监听
    void start();

private:
    EventLoop*                           m_loop;    // 绑定主线程的 mainloop
    std::string                          m_ip_with_port;
    std::string                          m_name;
    std::unique_ptr<Acceptor>            m_acceptor;
    std::shared_ptr<EventLoopThreadPool> m_thread_pool;

    std::unordered_map<std::string, TcpConnectionPtr> m_connections;

    ConnectionChangedCallback m_connchange_cb;    // 连接状态变化的回调
    REventCallback            m_readevent_cb;     // 读事件后的回调
    WEventCallback            m_writeevent_cb;    // 写事件后的回调
    ThreadInitCallback        m_threadinit_cb;    // m_loop 线程初始化的回调

    int            m_thread_num {1};              //线程池中线程的数量。
    int            m_next_conn_id {1};
    std::once_flag m_start_flag;

    friend class TcpConnection;
};

}    // namespace ltt
