export module Muduo.Timestamp;

import std;

namespace ltt
{

export class Timestamp
{
public:
    Timestamp();
    explicit Timestamp(std::chrono::system_clock::time_point time_point);
    [[nodiscard]]
    std::string to_string() const;

    static Timestamp now();

private:
    std::chrono::system_clock::time_point m_time_point;
};

}    // namespace ltt
