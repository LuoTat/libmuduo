export module Muduo.Logger;

import std;

namespace ltt
{

export {
    enum class LogLevel : std::uint8_t
    {
        FATAL,         // core dump 信息
        ERROR,         // 错误信息
        INFO,          // 普通信息
        DEBUG,         // 调试信息
        FUNC_BEGIN,    // 函数开始
        FUNC_END,      // 函数结束
        FUNC_INFO,     // 函数调用信息
    };

    struct Logger
    {
        Logger() = delete;

        Logger(const Logger&)            = delete;
        Logger& operator=(const Logger&) = delete;

        Logger(Logger&&)            = default;
        Logger& operator=(Logger&&) = default;

        ~Logger() = default;

        // 写日志
        static void log(LogLevel level, std::string_view msg);

        // 编译期控制
        static constexpr LogLevel m_build_loglevel {LogLevel::ERROR};
        // 运行期控制
        inline static LogLevel m_runtime_loglevel {LogLevel::ERROR};
    };

    // -------------------- 核心模板 --------------------
    template <LogLevel level, typename... Args>
    inline void LOG(std::format_string<Args...> fmt, Args&&... args)
    {
        if constexpr (level <= Logger::m_build_loglevel)
        {
            if (level <= Logger::m_runtime_loglevel)
            {
                Logger::log(level, std::format(fmt, std::forward<Args>(args)...));
            }
        }
    }

    // -------------------- 各别名函数 --------------------
    template <typename... Args>
    inline void LOG_FATAL(std::format_string<Args...> fmt, Args&&... args)
    {
        LOG<LogLevel::FATAL>(fmt, std::forward<Args>(args)...);
        std::exit(-1);
    }

    template <typename... Args>
    inline void LOG_ERROR(std::format_string<Args...> fmt, Args&&... args)
    {
        LOG<LogLevel::ERROR>(fmt, std::forward<Args>(args)...);
    }

    template <typename... Args>
    inline void LOG_INFO(std::format_string<Args...> fmt, Args&&... args)
    {
        LOG<LogLevel::INFO>(fmt, std::forward<Args>(args)...);
    }

    template <typename... Args>
    inline void LOG_DEBUG(std::format_string<Args...> fmt, Args&&... args)
    {
        LOG<LogLevel::DEBUG>(fmt, std::forward<Args>(args)...);
    }

    // -------------------- FUNC_BEGIN / FUNC_END --------------------
    inline void LOG_FUNC_BEGIN(std::string_view func_name = std::source_location::current().function_name())
    {
        if constexpr (LogLevel::FUNC_BEGIN <= Logger::m_build_loglevel)
        {
            if (LogLevel::FUNC_BEGIN <= Logger::m_runtime_loglevel)
            {
                Logger::log(LogLevel::FUNC_BEGIN, std::format("{} begin", func_name));
            }
        }
    }

    inline void LOG_FUNC_END(std::string_view func_name = std::source_location::current().function_name())
    {
        if constexpr (LogLevel::FUNC_END <= Logger::m_build_loglevel)
        {
            if (LogLevel::FUNC_END <= Logger::m_runtime_loglevel)
            {
                Logger::log(LogLevel::FUNC_END, std::format("{}   end", func_name));
            }
        }
    }
}

}    // namespace ltt
