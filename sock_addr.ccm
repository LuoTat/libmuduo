module;
#include <netinet/in.h>

export module Muduo.SockAddress;

import std;

namespace ltt
{

export class SockAddress
{
public:
    explicit SockAddress(std::string ip = "0.0.0.0", std::uint16_t port = 0);

    explicit SockAddress(sockaddr_in addr);

    [[nodiscard]]
    std::string get_ip() const;
    [[nodiscard]]
    std::string get_ip_with_port() const;
    [[nodiscard]]
    std::uint16_t get_port() const;

    [[nodiscard]]
    sockaddr_in get_sock_addr() const;
    void        set_sock_addr(sockaddr_in addr);

private:
    sockaddr_in m_sock_addr;
};

}    // namespace ltt