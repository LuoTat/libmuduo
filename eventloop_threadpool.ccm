module;
#include <boost/core/noncopyable.hpp>

export module Muduo.EventLoopThreadPool;

import std;
import Muduo.Core;
import Muduo.EventLoopThread;

namespace ltt
{

export class EventLoopThreadPool: private boost::noncopyable
{
public:
    using ThreadInitCallback = std::function<void(EventLoop*)>;

    EventLoopThreadPool(EventLoop* loop, std::string name);
    ~EventLoopThreadPool();

    void start(ThreadInitCallback cb);

    void       set_thread_num(int num);
    EventLoop* get_next_loop();
    [[nodiscard]]
    std::vector<EventLoop*> get_all_loops() const;
    [[nodiscard]]
    std::string get_name() const;
    [[nodiscard]]
    bool is_started() const;

private:
    EventLoop*                                    m_base_loop;          // 用户创建的 loop,如果线程数为 1,那直接使用用户创建的 loop,否则创建多个 EventLoop
    std::string                                   m_name;               // 线程池名称
    bool                                          m_started {false};    // 是否已经启动标志
    int                                           m_threads_num {0};    // 线程池中线程的数量
    std::size_t                                   m_next_id {0};        // 新连接到来，所选择 EventLoop 的索引
    std::vector<std::unique_ptr<EventLoopThread>> m_threads;            // 线程的列表
    std::vector<EventLoop*>                       m_loops;              // 线程池中 EventLoop 的列表，指向的是 EVentLoopThread 线程函数创建的 EventLoop 对象。
};

}    // namespace ltt