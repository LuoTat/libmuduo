export module Muduo.Core:Channel;

import std;
import Muduo.Timestamp;
import :Forward;

namespace ltt
{

export class Channel
{
public:
    using EventCallback  = std::function<void()>;
    using REventCallback = std::function<void(Timestamp)>;

    Channel(int fd, EPoll* epoll);

    Channel(const Channel&)            = delete;
    Channel& operator=(const Channel&) = delete;

    Channel(Channel&&)            = default;
    Channel& operator=(Channel&&) = default;

    ~Channel() = default;

    void set_read_callback(REventCallback cb);
    void set_write_callback(EventCallback cb);
    void set_error_callback(EventCallback cb);

    void add_read_event();
    void del_read_event();
    [[nodiscard]]
    bool has_read_event() const;
    void add_write_event();
    void del_write_event();
    [[nodiscard]]
    bool has_write_event() const;
    void del_all_event();
    [[nodiscard]]
    bool has_events() const;

    [[nodiscard]]
    EPoll* get_epoll() const;
    [[nodiscard]]
    int get_fd() const;
    [[nodiscard]]
    std::uint32_t get_events() const;
    void          set_ready_events(std::uint32_t ready_events);
    [[nodiscard]]
    bool is_in_epoll() const;
    void set_in_epoll(bool flag);

    void run_event(Timestamp receive_time);
    void tie(const std::shared_ptr<void>& tcp_con);
    void remove();

private:
    void update();

    EPoll*        m_epoll;               // 绑定的 epoll
    int           m_fd;                  // 绑定的 socket 文件描述符
    std::uint32_t m_events {0};          // 注册的所有事件
    std::uint32_t m_ready_events {0};    // poller 返回的就绪事件
    bool          m_in_epoll {false};

    std::weak_ptr<void> m_tcp_con;
    bool                m_tied {false};

    REventCallback m_read_cb;
    EventCallback  m_write_cb;
    EventCallback  m_error_cb;
};

}    // namespace ltt
