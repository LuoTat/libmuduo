export module Muduo.Socket;

import std;
import Muduo.SockAddress;

namespace ltt
{

export class Socket
{
public:
    explicit Socket(int sockfd);

    Socket(const Socket&)            = delete;
    Socket& operator=(const Socket&) = delete;

    Socket(Socket&&)            = default;
    Socket& operator=(Socket&&) = default;

    ~Socket();

    void bind(SockAddress addr) const;
    void listen() const;
    int  accept(SockAddress& peer_addr) const;
    void shutdown_write() const;

    [[nodiscard]]
    int  get_fd() const;
    void set_tcp_no_delay(bool flag) const;
    void set_reuse_addr(bool flag) const;
    void set_reuse_port(bool flag) const;
    void set_keep_alive(bool flag) const;

private:
    int m_sockfd;
};

}    // namespace ltt
