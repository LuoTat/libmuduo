module;
#include <boost/core/noncopyable.hpp>

export module Muduo.Acceptor;

import std;
import Muduo.Core;
import Muduo.Socket;
import Muduo.SockAddress;

namespace ltt
{

export class Acceptor: private boost::noncopyable
{
public:
    using NewConnectionCallback = std::function<void(int sockfd, const SockAddress&)>;

    Acceptor(EventLoop* eventloop, const SockAddress& addr);
    ~Acceptor();

    void listen();
    bool listenning() const;
    void set_new_conn_callback(NewConnectionCallback cb);

private:
    EventLoop*            m_eventloop;                // Acceptor 用的是 mainLoop 的 epoll
    Socket                m_accept_socket;            //专门用于接收新连接的 socket
    Channel               m_accept_channel;           //专门用于监听新连接的 channel
    NewConnectionCallback m_new_conn_callback;        //新连接的回调函数
    bool                  m_is_listenning {false};    //是否在监听
};

}    // namespace ltt